{
  "name": "@logicinczo/dotkolam",
  "version": "0.0.1",
  "description": "dotKolam (Kolam-JSON): a JSON specification for rule-bound Sikku (Kambi/Chikku) Kolam, with a validator, deterministic generator, SVG renderer, and CLI.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "kolam",
    "sikku",
    "kambi",
    "chikku",
    "kolam-json",
    "mirror-curve",
    "svg",
    "generator",
    "tamil"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LogicIncZo/dotkolam.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kolam": "./dist/cli.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "verify": "npm test && node scripts/formal.mjs",
    "kolam": "tsx src/cli.ts",
    "docs": "node scripts/build-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.17.0",
    "marked": "^18.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
